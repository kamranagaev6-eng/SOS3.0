{
  "name": "stabilityos-exercise-motion-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic, unreviewed exercise-motion authoring and playback engine with explicit contact constraints (engineering prototype for later selective adaptation into StabilityOS).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench:solver": "node --expose-gc bench/solver-bench.ts",
    "bench:render": "playwright test e2e/render-bench.spec.ts --project=bench",
    "report:metrics": "node scripts/metrics-report.ts",
    "report:roundtrip": "node scripts/roundtrip-report.ts",
    "report:env": "node scripts/env-report.ts",
    "verify": "npm run typecheck && npm run test && npm run report:metrics && npm run report:roundtrip",
    "docs:recipes": "node scripts/recipes-doc.ts",
    "example:host": "node examples/host-integration.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
